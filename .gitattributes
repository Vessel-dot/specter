# Normalizar saltos de línea automáticamente
* text=auto

# PHP y archivos de texto → LF en el repo
*.php text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.htaccess text eol=lf
Dockerfile text eol=lf

# Binarios → sin conversión
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
